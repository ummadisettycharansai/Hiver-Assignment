# LLM Provider Configuration
# Supported providers: mock, openai, anthropic, ollama
LLM_PROVIDER=mock

# Model selection (e.g. gpt-4o-mini, claude-3-5-haiku-20241022, etc.)
LLM_MODEL=gpt-4o-mini

# API Keys (leave blank if using LLM_PROVIDER=mock)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Temperature & Timeout
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30

# Reproducibility
RANDOM_SEED=42
